  "source_control_rules": [
    "An explicit catalogue cross-reference establishes a declared relation, not necessarily exact line-by-line scribal descent.",
    "Use folio range and content/title correspondence over item number alone when Cambridge cross-references conflict with current item boundaries.",
    "Never infer support from binding form when paper class is not stated.",
    "Machine-made is a formation class, not a secure national/maker attribution.",
    "Nepali hand-made is a catalogue material class, not a secure Kathmandu manufacture location.",
    "Treat original/source, copy, translation, summary, abstract, chart, register, notebook and report as distinct derivative states.",
    "Do not publish switch percentages until the entire inventory has been searched and unresolved cross-references reconciled."
  ],
  "new_model": "target_support = source_support × available_stock × actor_workplace × derivative_format × intended_operation × custody_publication_pathway",
