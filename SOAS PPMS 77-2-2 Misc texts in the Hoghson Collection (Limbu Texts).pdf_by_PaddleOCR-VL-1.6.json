[1037.0,1082.0],[1037.0,1174.0],[53.0,1174.0]]},{"cls_id":22,"label":"text","score":0.85561203956604,"coordinate":[41,1219,1106,1317],"order":10,"polygon_points":[[41.0,1219.0],[1106.0,1219.0],[1106.0,1317.0],[41.0,1317.0]]}]},"doc_preprocessor_res":{"model_settings":{"use_doc_orientation_classify":true,"use_doc_unwarping":true},"angle":0}},"markdown":{"text":"5.  $ \\underline{\\text{Songma yang}} $ - paid for the introduction of the bridegroom to the bride's nearest relatives.\n\n6.  $ \\underline{Si} $  $ \\underline{yang} $ - paid for the separation of the bride from her family to that of the bridegroom's.\n\n7.  $ \\underline{\\text{Thung yang}} $ - paid for the bride's services in her husband's house.\n\n8.  $ \\underline{Bai} $  $ \\underline{yang} $ - paid for the final announcement of the bride's father viz. giving his daughter in marriage to the groom.\n\n9.  $ \\underline{\\text{Suna mayang}} $ - paid for the separation of the bride from her mother.\n\n10.  $ \\underline{\\text{Phudong yang}} $ - paid for a marriage feast in honour of the bride.\n\n11.  $ \\underline{\\text{Tunai ma yang}} $ - paid for a peaceful marriage ceremony.\n\n12.  $ \\underline{\\text{Pharsut yang}} $ - paid for the registration and recognition of the legal marriage.\n\n13.  $ \\underline{\\text{Sing chem yang}} $ - paid for standing witness to such legal marriage.\n\n14.  $ \\underline{Parmi} $  $ \\underline{yang} $ - paid for the fee of the intermediary, the  $ \\underline{ing-mi-ba} $.","images":{}},"outputImages":{"layout_det_res":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//4ab6d24c-1f30-471e-a710-06b74fb56b99/layout_det_res_1.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A34Z%2F-1%2F%2F601e16e102eb492747180ccbabd1ed54e068df3898eb823c66b9702e6c856594"},"inputImage":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//4ab6d24c-1f30-471e-a710-06b74fb56b99/input_img_1.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A34Z%2F-1%2F%2F72e0aa713b1c1df61424eab4d4c8741c7b181d8bad0030a563200a1ad3026693"}]