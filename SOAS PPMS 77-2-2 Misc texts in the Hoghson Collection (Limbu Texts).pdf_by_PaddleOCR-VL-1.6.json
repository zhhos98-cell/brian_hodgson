nline.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//91282da1-ec1e-4e8e-a61c-4f7a88e23122/layout_det_res_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A34Z%2F-1%2F%2F429ad44e60e494b7123f692468baf636dfc7aa4f1097775d1487a9df750c058a"},"inputImage":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//91282da1-ec1e-4e8e-a61c-4f7a88e23122/input_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A34Z%2F-1%2F%2F94e19fafa1e20f9dfec6bf9275339247e23ecaeac8edad371099292c4a6b67eb"},{"prunedResult":{"model_settings":{"use_doc_preprocessor":true,"use_layout_detection":true,"use_chart_recognition":true,"use_seal_recognition":true,"use_ocr_for_image_block":true,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"text","block_content":"Hodgson, B.H.  $ \\underline{\\text{Miscellaneous Essays Relating to Indian Subjects. Vol II. London: Trubner & Co. 1880.}} $ Section XI, \"Route from Kathmandu, The Capital of Nepal, to Darjeeling in Sikkim\", pp 191 - 205","block_bbox":[192,32,1097,256],"block_id":0,"block_order":1,"group_id":0,"block_polygon_points":[[192.0,32.0],[1097.0,32.0],[1097.0,256.0],[192.0,256.0]]},{"block_label":"text","block_content":"p.201. Dhankutta is the largest and most important place in Eastern Nepal, and the headquarters of the civil and military administrator of all the country east of the Dudi Cossi to the Sikik frontier excepting only what is under the inferior and subordinate officer stationed at Ilam.","block_bbox":[208,323,1082,600],"block_id":1,"block_order":2,"group_id":1,"block_polygon_points":[[208.0,323.0],[1082.0,323.0],[1082.0,600.0],[208.0,600.0]]},{"block_label":"text","block_content":"p. 204. The Chatelain of Ilam, a small fort designed to guard the eastern frontier of Nepal, \"is a captain and has a hundred soldiers under him, with eight artillerymen and one HERRER cannon of small calibre. This officer is also the civil authority of the arondissement, and raises the extra-ordinary revenues thereof to meet the local expenses, sending the balance, if any, to Kathmandu. The land revenue is wholly assigned to his troops in pay.\"","block_bbox":[211,647,1117,1104],"block_id":2,"block_order":3,"group_id":2,"block_polygon_points":[[211.0,647.0],[1117.0,647.0],[1117.0,1104.0],[211.0,1104.0]]},{"block_label":"text","block_content":"The writer of this 'history', Joghan Singh Page Ltd. (1843) classes \"The Limbo Language, oustering and behaviour\" do not agree with the language, ouster and behavior of the Corrhao.\"","block_bbox":[239,1180,1103,1397],"block_id":3,"block_order":4,"group_id":3,"block_polygon_points":[[238.81578063964844,1181.216796875],[1077.3465576171875,1171.423583984375],[1079.85546875,1386.249755859375],[241.32470703125,1396.04296875]]}],"layout_det_res":{"boxes":[{"cls_id":22,"label":"text","score":0.8850945830345154,"coordinate":[192,32,1097,256],"order":1,"polygon_points":[[192.0,32.0],[1097.0,32.0],[1097.0,256.0],[192.0,256.0]]},{"cls_id":22,"label":"text","score":0.8779274225234985,"coordinate":[208,323,1082,600],"order":2,"polygon_points":[[208.0,323.0],[1082.0,323.0],[1082.0,600.0],[208.0,600.0]]},{"cls_id":22,"label":"text","score":0.8946822881698608,"coordinate":[211,647,1117,1104],"order":3,"polygon_points":[[211.0,647.0],[1117.0,647.0],[1117.0,1104.0],[211.0,1104.0]]},{"cls_id":22,"label":"text","score":0.49491065740585327,"coordinate":[239,1180,1103,1397],"order":4,"polygon_points":[[238.81578063964844,1181.216796875],[1077.3465576171875,1171.423583984375],[1079.85546875,1386.249755859375],[241.32470703125,1396.04296875]]}]},"doc_preprocessor_res":{"model_settings":{"use_doc_orientation_classify":true,"use_doc_unwarping":true},"angle":0}},"markdown":{"text":"Hodgson, B.H.  $ \\underline{\\text{Miscellaneous Essays Relating to Indian Subjects. Vol II. London: Trubner & Co. 1880.}} $ Section XI, \"Route from Kathmandu, The Capital of Nepal, to Darjeeling in Sikkim\", pp 191 - 205\n\np.201. Dhankutta is the largest and most important place in Eastern Nepal, and the headquarters of the civil and military administrator of all the country east of the Dudi Cossi to the Sikik frontier excepting only what is under the inferior and subordinate officer stationed at Ilam.\n\np. 204. The Chatelain of Ilam, a small fort designed to guard the eastern frontier of Nepal, \"is a captain and has a hundred soldiers under him, with eight artillerymen and one HERRER cannon of small calibre. This officer is also the civil authority of the arondissement, and raises the extra-ordinary revenues thereof to meet the local expenses, sending the balance, if any, to Kathmandu. The land revenue is wholly assigned to his troops in pay.\"\n\nThe writer of this 'history', Joghan Singh Page Ltd. (1843) classes \"The Limbo Language, oustering and behaviour\" do not agree with the language, ouster and behavior of the Corrhao.\"","images":{}},"outputImages":{"layout_det_res":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//91282da1-ec1e-4e8e-a61c-4f7a88e23122/layout_det_res_1.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A34Z%2F-1%2F%2Fabe0efb186fb3f46f7a40fffad34f5b2b718311c87bbb497cefe8a254d1fb627"},"inputImage":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//91282da1-ec1e-4e8e-a61c-4f7a88e23122/input_img_1.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A34Z%2F-1%2F%2F5f41532ce60acec16d30b488e786ddc4744e0eab401e2db1f2fe233cb4068ae9"},{"prunedResult":{"model_settings":{"use_doc_preprocessor":true,"use_layout_detection":true,"use_chart_recognition":true,"use_seal_recognition":true,"use_ocr_for_image_block":true,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"text","block_content":"Misc texts in the Hodson Collection presented to the India Office Library. Translation of Limbu texts by I.S. Chemjong.","block_bbox":[174,0,1006,212],"block_id":0,"block_order":1,"group_id":0,"block_polygon_points":[[174.0,-1.0],[1006.0,-1.0],[1006.0,212.0],[174.0,212.0]]},{"block_label":"paragraph_title","block_content":"##  $ \\underline{\\text{Limbu History}} $","block_bbox":[424,284,631,327],"block_id":1,"block_order":2,"group_id":1,"block_polygon_points":[[424.0,284.0],[631.0,284.0],[631.0,327.0],[424.0,327.0]]},{"block_label":"text","block_content":"(The author) speaks of a decisive battle on the banks of the Tambur between Sikkimese and Gorkhas. The former were defeated and fled to Ilam which was, like all Limbuan, in Sikhism territory.","block_bbox":[205,374,1052,602],"block_id":2,"block_order":3,"group_id":2,"block_polygon_points":[[205.0,374.0],[1052.0,374.0],[1052.0,602.0],[205.0,602.0]]},{"block_label":"text","block_content":"From that time the Limbus were divided into two groups. Those who fought for and those who fought against the Gorkhas.","block_bbox":[196,628,955,788],"block_id":3,"block_order":4,"group_id":3,"block_polygon_points":[[195.44461059570312,636.31298828125],[954.0,628.0],[955.654052734375,778.9271240234375],[197.0986328125,787.2401123046875]]},{"block_label":"text","block_content":"Many of the latter (32,000) fled to Bhutan and Assam. The Gorkhas also perpetrated many atrocities on those they suspected of having aided the Sikhinese.","block_bbox":[217,812,1036,960],"block_id":4,"block_order":5,"group_id":4,"block_polygon_points":[[215.4618377685547,821.0840454101562],[1033.5386962890625,811.9605102539062],[1035.1771240234375,958.8753051757812],[217.1002197265625,967.9988403320312]]},{"block_label":"text","block_content":"The writer of this 'history', Joghan Singh Phago Limbu (1843) closes: \"The Limbu language, custom and behavior do not agree with the language, custom and behavior of the Gorkhas.\"","block_bbox":[197,994,1058,1203],"block_id":5,"block_order":6,"group_id":5,"block_polygon_points":[[197.0,994.0],[1058.0,994.0],[1058.0,1203.0],[197.0,1203.0]]}],"layout_det_res":{"boxes":[{"cls_id":22,"label":"text","score":0.8649675250053406,"coordinate":[174,0,1006,212],"order":1,"polygon_points":[[174.0,-1.0],[1006.0,-1.0],[1006.0,212.0],[174.0,212.0]]},{"cls_id":17,"label":"paragraph_title","score":0.6786590814590454,"coordinate":[424,284,631,327],"order":2,"polygon_points":[[424.0,284.0],[631.0,284.0],[631.0,327.0],[424.0,327.0]]},{"cls_id":22,"label":"text","score":0.8860499858856201,"coordinate":[205,374,1052,602],"order":3,"polygon_points":[[205.0,374.0],[1052.0,374.0],[1052.0,602.0],[205.0,602.0]]},{"cls_id":22,"label":"text","score":0.8642493486404419,"coordinate":[196,628,955,788],"order":4,"polygon_points":[[195.44461059570312,636.31298828125],[954.0,628.0],[955.654052734375,778.9271240234375],[197.0986328125,787.2401123046875]]},{"cls_id":22,"label":"text","score":0.8707423210144043,"coordinate":[217,812,1036,960],"order":5,"polygon_points":[[215.4618377685547,821.0840454101562],[1033.5386962890625,811.9605102539062],[1035.1771240234375,958.8753051757812],[217.1002197265625,967.9988403320312]]},{"cls_id":22,"label":"text","score":0.8782161474227905,"coordinate":[197,994,1058,1203],"order":6,"polygon_points":[[197.0,994.0],[1058.0,994.0],[1058.0,1203.0],[197.0,1203.0]]}]},"doc_preprocessor_res":{"model_settings":{"use_doc_orientation_classify":true,"use_doc_unwarping":true},"angle":0}},"markdown":{"text":"Misc texts in the Hodson Collection presented to the India Office Library. Translation of Limbu texts by I.S. Chemjong.\n\n##  $ \\underline{\\text{Limbu History}} $\n\n(The author) speaks of a decisive battle on the banks of the Tambur between Sikkimese and Gorkhas. The former were defeated and fled to Ilam which was, like all Limbuan, in Sikhism territory.\n\nFrom that time the Limbus were divided into two groups. Those who fought for and those who fought against the Gorkhas.\n\nMany of the latter (32,000) fled to Bhutan and Assam. The Gorkhas also perpetrated many atrocities on those they suspected of having aided the Sikhinese.\n\nThe writer of this 'history', Joghan Singh Phago Limbu (1843) closes: \"The Limbu language, custom and behavior do not agree with the language, custom and behavior of the Gorkhas.\"","images":{}},"outputImages":{"layout_det_res":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//91282da1-ec1e-4e8e-a61c-4f7a88e23122/layout_det_res_2.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A35Z%2F-1%2F%2F95206705c7abe05edd4e01332354554251bc479be386b61858264be68257acf4"},"inputImage":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//91282da1-ec1e-4e8e-a61c-4f7a88e23122/input_img_2.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A35Z%2F-1%2F%2F05e2a277a40c12d88d934d902165bee297dadbb2d7758377cdfbc94dd8932f81"},{"prunedResult":{"model_settings":{"use_doc_preprocessor":true,"use_layout_detection":true,"use_chart_recognition":true,"use_seal_recognition":true,"use_ocr_for_image_block":true,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"text","block_content":"Misc. Texts in the Hodgson Collection in India Office Library. Translation of Limbu texts by I. S. Chemjtong.","block_bbox":[216,79,1071,175],"block_id":0,"block_order":1,"group_id":0,"block_polygon_points":[[216.0,79.0],[1071.0,79.0],[1071.0,175.0],[216.0,175.0]]},{"block_label":"paragraph_title","block_content":"#### Ritual","block_bbox":[561,189,669,227],"block_id":1,"block_order":2,"group_id":1,"block_polygon_points":[[561.0,189.0],[669.0,189.0],[669.0,227.0],[561.0,227.0]]},{"block_label":"text","block_content":" $ \\underline{\\text{Ningwa phuma}} $ is the creator - the 'mine of knowledge'. (this is Chemjong's translation of the Limbu Ningwa-phuma).","block_bbox":[215,245,1162,347],"block_id":2,"block_order":3,"group_id":2,"block_polygon_points":[[215.0,245.0],[1162.0,245.0],[1162.0,347.0],[215.0,347.0]]},{"block_label":"text","block_content":" $ \\underline{\\text{porok-miha}} $ is the instrument of creation, who derives his wisdom from Ningwa phuma to whom he constantly goes for inspiration.","block_bbox":[211,388,1153,540],"block_id":3,"block_order":4,"group_id":3,"block_polygon_points":[[211.0,388.0],[1153.0,388.0],[1153.0,540.0],[211.0,540.0]]},{"block_label":"text","block_content":"The first creature (in one creation story) is a woman called  $ \\underline{\\text{Nujingma}} $  $ \\underline{\\text{Khimogna}} $ who is impregnated by the winds.","block_bbox":[203,585,1112,740],"block_id":4,"block_order":5,"group_id":4,"block_polygon_points":[[203.0,585.0],[1112.0,585.0],[1112.0,740.0],[203.0,740.0]]},{"block_label":"text","block_content":"Her son when grown coupled with  $ \\underline{\\text{Mugum Lungma}} $. (Earlier he coupled with another woman). The child was called  $ \\underline{\\text{Lingdam Khema}} $.","block_bbox":[206,787,1165,942],"block_id":5,"block_order":6,"group_id":5,"block_polygon_points":[[206.0,787.0],[1165.0,787.0],[1165.0,942.0],[206.0,942.0]]},{"block_label":"text","block_content":"A deity called  $ \\underline{\\text{Okmanan}} $ is referred to as the supporter of the Earth.","block_bbox":[192,988,1001,1085],"block_id":6,"block_order":7,"group_id":6,"block_polygon_points":[[192.0,988.0],[1001.0,988.0],[1001.0,1085.0],[192.0,1085.0]]},{"block_label":"text","block_content":" $ \\underline{\\text{Him-samang}} $ is referred to as \"the spirit god of the house\".","block_bbox":[207,1112,1092,1210],"block_id":7,"block_order":8,"group_id":7,"block_polygon_points":[[207.0,1112.0],[1092.0,1112.0],[1092.0,1210.0],[207.0,1210.0]]},{"block_label":"text","block_content":"Creation: Porok-hima was the creator of the earth.\n\n(Following the usual story of gold, silver image etc.)\n\n....\" he spat at the human image and said: 'you have\n\nbecome EXENTSE man out of such mean materials.' His spitting\n\nhas become a curse and so the trouble in human life was\n\ncreated.\"","block_bbox":[210,1255,1188,1574],"block_id":8,"block_order":9,"group_id":8,"block_polygon_points":[[210.0,1255.0],[1188.0,1255.0],[1188.0,1574.0],[210.0,1574.0]]}],"layout_det_res":{"boxes":[{"cls_id":22,"label":"text","score":0.7529395818710327,"coordinate":[216,79,1071,175],"order":1,"polygon_points":[[216.0,79.0],[1071.0,79.0],[1071.0,175.0],[216.0,175.0]]},{"cls_id":17,"label":"paragraph_title","score":0.3844301104545593,"coordinate":[561,189,669,227],"order":2,"polygon_points":[[561.0,189.0],[669.0,189.0],[669.0,227.0],[561.0,227.0]]},{"cls_id":22,"label":"text","score":0.8322931528091431,"coordinate":[215,245,1162,347],"order":3,"polygon_points":[[215.0,245.0],[1162.0,245.0],[1162.0,347.0],[215.0,347.0]]},{"cls_id":22,"label":"text","score":0.9027658700942993,"coordinate":[211,388,1153,540],"order":4,"polygon_points":[[211.0,388.0],[1153.0,388.0],[1153.0,540.0],[211.0,540.0]]},{"cls_id":22,"label":"text","score":0.8805656433105469,"coordinate":[203,585,1112,740],"order":5,"polygon_points":[[203.0,585.0],[1112.0,585.0],[1112.0,740.0],[203.0,740.0]]},{"cls_id":22,"label":"text","score":0.8922927975654602,"coordinate":[206,787,1165,942],"order":6,"polygon_points":[[206.0,787.0],[1165.0,787.0],[1165.0,942.0],[206.0,942.0]]},{"cls_id":22,"label":"text","score":0.8282648921012878,"coordinate":[192,988,1001,1085],"order":7,"polygon_points":[[192.0,988.0],[1001.0,988.0],[1001.0,1085.0],[192.0,1085.0]]},{"cls_id":22,"label":"text","score":0.8556547164916992,"coordinate":[207,1112,1092,1210],"order":8,"polygon_points":[[207.0,1112.0],[1092.0,1112.0],[1092.0,1210.0],[207.0,1210.0]]},{"cls_id":22,"label":"text","score":0.8620513677597046,"coordinate":[210,1255,1188,1574],"order":9,"polygon_points":[[210.0,1255.0],[1188.0,1255.0],[1188.0,1574.0],[210.0,1574.0]]}]},"doc_preprocessor_res":{"model_settings":{"use_doc_orientation_classify":true,"use_doc_unwarping":true},"angle":0}},"markdown":{"text":"Misc. Texts in the Hodgson Collection in India Office Library. Translation of Limbu texts by I. S. Chemjtong.\n\n#### Ritual\n\n $ \\underline{\\text{Ningwa phuma}} $ is the creator - the 'mine of knowledge'. (this is Chemjong's translation of the Limbu Ningwa-phuma).\n\n $ \\underline{\\text{porok-miha}} $ is the instrument of creation, who derives his wisdom from Ningwa phuma to whom he constantly goes for inspiration.\n\nThe first creature (in one creation story) is a woman called  $ \\underline{\\text{Nujingma}} $  $ \\underline{\\text{Khimogna}} $ who is impregnated by the winds.\n\nHer son when grown coupled with  $ \\underline{\\text{Mugum Lungma}} $. (Earlier he coupled with another woman). The child was called  $ \\underline{\\text{Lingdam Khema}} $.\n\nA deity called  $ \\underline{\\text{Okmanan}} $ is referred to as the supporter of the Earth.\n\n $ \\underline{\\text{Him-samang}} $ is referred to as \"the spirit god of the house\".\n\nCreation: Porok-hima was the creator of the earth.\n\n(Following the usual story of gold, silver image etc.)\n\n....\" he spat at the human image and said: 'you have\n\nbecome EXENTSE man out of such mean materials.' His spitting\n\nhas become a curse and so the trouble in human life was\n\ncreated.\"","images":{}},"outputImages":{"layout_det_res":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//91282da1-ec1e-4e8e-a61c-4f7a88e23122/layout_det_res_3.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A35Z%2F-1%2F%2F13cc1cd32a7bbf2ac8840378355b1a8f8abe74005a72bd6117cbd0b711fc8f56"},"inputImage":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//91282da1-ec1e-4e8e-a61c-4f7a88e23122/input_img_3.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A36Z%2F-1%2F%2Fd314c82a850c921c00b7a2a802c25d1b2e0569057c8b8bb37053fc5f1453d47e"},{"prunedResult":{"model_settings":{"use_doc_preprocessor":true,"use_layout_detection":true,"use_chart_recognition":true,"use_seal_recognition":true,"use_ocr_for_image_block":true,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"text","block_content":"Misc Limbu texts in the Hodgson Collection. Translated by I.S. Chemjong","block_bbox":[119,0,1091,127],"block_id":0,"block_order":1,"group_id":0,"block_polygon_points":[[119.0,0.0],[1090.0,0.0],[1090.0,119.0],[119.0,119.0]]},{"block_label":"paragraph_title","block_content":"### Marriage","block_bbox":[428,245,574,285],"block_id":1,"block_order":2,"group_id":1,"block_polygon_points":[[428.0,245.0],[574.0,245.0],[574.0,285.0],[428.0,285.0]]},{"block_label":"text","block_content":" $ \\underline{\\text{Marriage}} $  $ \\underline{\\text{Law}} $  $ \\underline{\\text{of}} $  $ \\underline{\\text{the}} $  $ \\underline{\\text{Limbus}} $\n\nVol 74.","block_bbox":[155,327,609,427],"block_id":2,"block_order":3,"group_id":2,"block_polygon_points":[[155.0,327.0],[609.0,327.0],[609.0,427.0],[155.0,427.0]]},{"block_label":"text","block_content":"The children divided among husband and wife after divorce remain illegitimate if the marriage tax of Rs 2 according to the final rule of  $ \\underline{\\text{sai mundri}} $ is not paid in full.","block_bbox":[153,471,1129,696],"block_id":3,"block_order":4,"group_id":3,"block_polygon_points":[[153.0,471.0],[1129.0,471.0],[1129.0,696.0],[153.0,696.0]]},{"block_label":"text",