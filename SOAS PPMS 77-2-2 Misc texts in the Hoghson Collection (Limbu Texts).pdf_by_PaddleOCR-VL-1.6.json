3.0,1534.0],[179.0,1534.0]]}]},"doc_preprocessor_res":{"model_settings":{"use_doc_orientation_classify":true,"use_doc_unwarping":true},"angle":0}},"markdown":{"text":"Misc Limbu texts in the Hodgson Collection. Translated by I.S. Chemjong\n\n### Marriage\n\n $ \\underline{\\text{Marriage}} $  $ \\underline{\\text{Law}} $  $ \\underline{\\text{of}} $  $ \\underline{\\text{the}} $  $ \\underline{\\text{Limbus}} $\n\nVol 74.\n\nThe children divided among husband and wife after divorce remain illegitimate if the marriage tax of Rs 2 according to the final rule of  $ \\underline{\\text{sai mundri}} $ is not paid in full.\n\nIncestuous marriage is punished by banishment and public shame.\n\n### Marriage Tax\n\n1.  $ \\underline{\\text{Pan tapma yang}} $ - paid for opening negotiations between the two families.\n\n2.  $ \\underline{\\text{Tharey tomna yang}} $ - paid for the steps to come up to the house of the bride.\n\n3.  $ \\underline{\\text{Peco sama yang}} $ - paid for the announcement of the girl's name to be married.\n\n4.  $ \\underline{\\text{Paja maja yang}} $ - paid for the introduction of the bridegroom to the bride's parents.","images":{}},"outputImages":{"layout_det_res":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//4ab6d24c-1f30-471e-a710-06b74fb56b99/layout_det_res_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A34Z%2F-1%2F%2Fc1736bf5dbbf06966d48c94507fab45a724cfc4dbd346c9998fa0055a5838067"},"inputImage":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//4ab6d24c-1f30-471e-a710-06b74fb56b99/input_img_0.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-08-31T10%3A10%3A34Z%2F-1%2F%2F5cecf1d0fc7dfb5d88d8d9408dc1648e2c89b649005e7155b179823c572547fc"},{"prunedResult":{"model_settings":{"use_doc_preprocessor":true,"use_layout_detection":true,"use_chart_recognition":true,"use_seal_recognition":true,"use_ocr_for_image_block":true,"format_blo