04,689],"block_id":4,"block_order":5,"group_id":4,"block_polygon_points":[[73.30809783935547,599.0054321289062],[1102.9998779296875,590.9999389648438],[1103.7408447265625,686.2915649414062],[74.049072265625,694.2970581054688]]},{"block_label":"text","block_content":"10.  $ \\underline{\\text{Phudong yang}} $ - paid for a marriage feast in honour of the bride.","block_bbox":[72,729,1089,822],"block_id":5,"block_order":6,"group_id":5,"block_polygon_points":[[72.0,729.0],[1089.0,729.0],[1089.0,822.0],[72.0,822.0]]},{"block_label":"text","block_content":"11.  $ \\underline{\\text{Tunai ma yang}} $ - paid for a peaceful marriage ceremony.","block_bbox":[67,864,1099,903],"block_id":6,"block_order":7,"group_id":6,"block_polygon_points":[[66.78929901123047,871.0014038085938],[1098.0,863.9999389648438],[1098.21044921875,894.9984741210938],[66.999755859375,901.9999389648438]]},{"block_label":"text","block_content":"12.  $ \\underline{\\text{Pharsut yang}} $ - paid for the registration and recognition of the legal marriage.","block_bbox":[62,944,1143,1038],"block_id":7,"block_order":8,"group_id":7,"block_polygon_points":[[62.00001525878906,952.0],[1142.0,944.0001220703125],[1142.6884765625,1036.9580078125],[62.6884765625,1044.9578857421875]]},{"block_label":"text","block_content":"13.  $ \\underline{\\text{Sing chem yang}} $ - paid for standing witness to such legal marriage.","block_bbox":[53,1082,1037,1174],"block_id":8,"block_order":9,"group_id":8,"block_polygon_points":[[53.0,1082.0],[1037.0,1082.0],[1037.0,1174.0],[53.0,1174.0]]},{"block_label":"text","block_content":"14.  $ \\underline{Parmi} $  $ \\underline{yang} $ - paid for the fee of the intermediary, the  $ \\underline{ing-mi-ba} $.","block_bbox":[41,1219,1106,1317],"block_id":9,"block_order":10,"group_id":9,"block_polygon_points":[[41.0,1219.0],[1106.0,1219.0],[1106.0,1317.0],[41.0,1317.0]]}],"layout_det_res":{"boxes":[{"cls_id":22,"label":"text","score":0.8778066039085388,"coordinate":[74,56,1137,164],"order":1,"